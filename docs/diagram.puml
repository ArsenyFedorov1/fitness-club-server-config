@startuml
!define RECTANGLE class

title Диаграмма развёртывания системы фитнес-клуба

' Внешние сущности
actor "Клиент" as Client
actor "Администратор" as Admin

' Внешние сервисы
cloud "Интернет" as Internet
cloud "Email SMTP" as Email
cloud "Telegram Bot API" as Telegram

' Брандмауэр
node "Брандмауэр (firewalld)\nПорты: 8080, 5432" as Firewall

' Сервер
node "Сервер Fedora Linux" as Server {
    
    ' База данных
    database "PostgreSQL 15\nfitness_db" as PG
    
    ' Docker контейнеры
    node "Docker окружение" as Docker {
        database "MariaDB" as Maria
        database "Redis Cache" as RedisCache
        database "Redis Queue" as RedisQueue
        node "ERPNext Worker\nv16" as ERPNext
        node "Nginx\n:8080" as Nginx
    }
    
    ' Автоматизация
    node "Ansible\n(автоматическая\nустановка)" as Ansible
    
    ' Бэкапы
    node "Backup система" as Backup {
        node "Python скрипт\nbackup.py" as PyBackup
        node "Cron\n(ежедневно 2:00)" as Cron
    }
}

' Связи
Client --> Internet : HTTP
Internet --> Firewall
Firewall --> Nginx : порт 8080
Nginx --> ERPNext : прокси
ERPNext --> Maria : SQL
ERPNext --> RedisCache : кэш
ERPNext --> RedisQueue : очередь
ERPNext --> Email : уведомления
ERPNext --> Telegram : отзывы
Admin --> Ansible : запуск
Ansible --> Server : настройка
PG --> PyBackup : данные
PyBackup --> Cron : расписание
Admin --> PG : управление

' Цвета
skinparam node {
    BackgroundColor LightBlue
    BorderColor DarkBlue
}

skinparam database {
    BackgroundColor LightGreen
    BorderColor DarkGreen
}

@enduml
