services:
  mariadb:
    image: mariadb:11.8
    container_name: erpnext_db
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: admin123
    volumes:
      - erpnext_db_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      timeout: 20s
      retries: 10

  redis:
    image: redis:6.2-alpine
    container_name: erpnext_redis
    restart: unless-stopped
    volumes:
      - erpnext_redis_data:/data

  erpnext:
    image: frappe/erpnext:v16.20.1
    container_name: erpnext_app
    restart: unless-stopped
    ports:
      - "8080:8000"
    environment:
      - SITE_NAME=fitness.local
      - ADMIN_PASSWORD=admin
      - MYSQL_ROOT_PASSWORD=admin123
      - DB_HOST=mariadb
      - REDIS_HOST=redis
    volumes:
      - erpnext_sites:/home/frappe/frappe-bench/sites
    depends_on:
      mariadb:
        condition: service_healthy
      redis:
        condition: service_started

volumes:
  erpnext_db_data:
  erpnext_redis_data:
  erpnext_sites:
